# Append this site block to the EXISTING Caddyfile only after owner approval.
# Keep its current global options and test.elektro-24.ru block byte-for-byte.
preview.elektro-24.ru {
  header {
    X-Robots-Tag "noindex, nofollow, noarchive"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
  header -Server
  handle_errors {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    respond "Request failed" {err.status_code}
  }
  route {
    basic_auth {
      import /run/secrets/storefront_basic_auth
    }
    reverse_proxy preview-web:3000
  }
}
