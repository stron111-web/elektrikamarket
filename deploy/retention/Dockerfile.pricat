# Narrow overlay: no dependency rebuild or changes to trading rules.
# Installer must verify this local tag resolves to af505ab13eb4... before build.
FROM elektrikamarket-pricat:v2-33385b4
ARG RELEASE_COMMIT
LABEL org.opencontainers.image.revision=$RELEASE_COMMIT
COPY scripts/pricat-update/sync.cjs scripts/pricat-update/update.cjs scripts/pricat-update/diagnostic-retention.cjs /work/scripts/pricat-update/
