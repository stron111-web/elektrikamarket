# Narrow overlay on the installed supervised PRODAT; preserve its existing runtime.
# Installer must verify this local tag resolves to 62b2dc5eb1e8... before build.
FROM elektrikamarket-prodat:supervised-107f144
ARG RELEASE_COMMIT
LABEL org.opencontainers.image.revision=$RELEASE_COMMIT
COPY scripts/prodat-update/cleanup.cjs /work/scripts/prodat-update/
