generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([name])
  @@map("brands")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  parentId  Int?

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                  Int      @id @default(autoincrement())

  // Коды поставщика
  supplierCode        String   @unique
  receiverCode        String?
  itemId              Int?

  // Основные данные
  name                String
  slug                String   @unique
  description         String?

  // Бренд
  brandId             Int?
  brand               Brand?   @relation(fields: [brandId], references: [id])

  vendorNumber        String?

  // Категория
  categoryId          Int?
  category            Category? @relation(fields: [categoryId], references: [id])

  // PRODAT
  country             String?
  guaranteePeriod     String?
  uom                 String?
  itemsPerUom         Decimal? @db.Decimal(12, 3)
  itemsPerUnit        Decimal? @db.Decimal(12, 3)
  multiplicity        Decimal? @db.Decimal(12, 3)

  parentProdCode      String?
  parentProdGroup     String?
  productCode         String?
  productGroup        String?
  rsCatalog           String?

  // Дополнительные данные
  tnved               String?
  okpd2               String?
  minprom             String?
  labelledItemChz     Boolean?
  productGroupChz     String?

  // PRICAT
  analitCat           String?
  lastPricatUpdate    DateTime?
  estimatedArrivalDate DateTime?

  blockExpAll         Boolean @default(false)
  blockExpBy          Boolean @default(false)
  blockExpKz          Boolean @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  barcodes             ProductBarcode[]
  features             ProductFeature[]
  images               ProductImage[]
  documents            ProductDocument[]
  relationsFrom        ProductRelation[] @relation("RelationFrom")
  relationsTo          ProductRelation[] @relation("RelationTo")
  stocks               ProductStock[]
  prices               ProductPrice[]

  @@index([name])
  @@index([brandId])
  @@index([categoryId])
  @@index([vendorNumber])
  @@index([productCode])
  @@map("products")
}

model ProductBarcode {
  id        Int    @id @default(autoincrement())
  productId Int
  barcode   String
  type      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, barcode])
  @@index([barcode])
  @@map("product_barcodes")
}

model ProductFeature {
  id          Int    @id @default(autoincrement())
  productId   Int
  featureCode String?
  featureName String
  featureValue String
  featureUom  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([featureCode])
  @@map("product_features")
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int    @default(0)
  alt       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductDocument {
  id        Int    @id @default(autoincrement())
  productId Int
  type      String
  url       String
  name      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_documents")
}

model ProductRelation {
  id            Int    @id @default(autoincrement())
  productId     Int
  relatedId     Int
  relationType  String

  product Product @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelationTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, relationType])
  @@index([productId])
  @@index([relatedId])
  @@map("product_relations")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  sortOrder Int      @default(0)

  stocks ProductStock[]

  @@map("warehouses")
}

model ProductStock {
  id          Int      @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Decimal  @db.Decimal(12, 3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("product_stocks")
}

model ProductPrice {
  id            Int      @id @default(autoincrement())
  productId     Int

  retailPrice   Decimal? @db.Decimal(14, 2)
  custPrice     Decimal? @db.Decimal(14, 2)
  price2        Decimal? @db.Decimal(14, 2)
  mrc           Decimal? @db.Decimal(14, 2)
  bsp           Decimal? @db.Decimal(14, 2)

  currency      String?

  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_prices")
}